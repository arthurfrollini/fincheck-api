{
  "uid": "fincheck-llm",
  "title": "fincheck · LLM",
  "tags": [
    "fincheck",
    "llm"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "description": "Claude API spend, tokens and outcomes per feature (categorization, RAG, agent), from the fincheck-api Prometheus exporter.",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Spend and volume",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "LLM spend (USD)",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": null,
      "targets": [
        {
          "refId": "A",
          "expr": "sum(fincheck_llm_cost_usd_total)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "description": "Counters are cumulative since the API process started; they reset on restart."
    },
    {
      "id": 3,
      "title": "Model calls",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": null,
      "targets": [
        {
          "refId": "A",
          "expr": "sum(fincheck_llm_requests_total)",
          "legendFormat": ""
